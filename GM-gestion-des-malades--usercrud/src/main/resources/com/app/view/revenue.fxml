<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" onMouseDragged="#onWindowDragged" onMousePressed="#onWindowPressed" prefHeight="900.0" prefWidth="1400.0" styleClass="dashboard-container" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.controller.RevenueController">
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <!-- Sidebar -->
            <left>
                <VBox prefWidth="250.0" styleClass="sidebar">
                    <children>
                        <Label text="App Médecin" styleClass="sidebar-logo">
                            <VBox.margin>
                                <Insets bottom="50.0" left="25.0" right="25.0" top="30.0" />
                            </VBox.margin>
                        </Label>
                        
                        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets left="20.0" right="20.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#navDashboard" styleClass="menu-item">
                                    <children>
                                        <SVGPath content="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" fill="WHITE" />
                                        <Label text="Tableau de bord" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#navPatients" styleClass="menu-item">
                                    <children>
                                        <SVGPath content="M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4s-4,1.79-4,4S9.79,12,12,12z M12,14c-2.67,0-8,1.34-8,4v2h16v-2C20,15.34,14.67,14,12,14z" fill="#b8c2d1" />
                                        <Label text="Patients" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#navAppointments" styleClass="menu-item">
                                    <children>
                                        <SVGPath content="M19,3h-1V1h-2v2H8V1H6v2H5C3.89,3,3,3.9,3,5v14c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.11,3,19,3z M19,19H5V8h14V19z" fill="#b8c2d1" />
                                        <Label text="Rendez-vous" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#navTasks" styleClass="menu-item">
                                    <children>
                                        <SVGPath content="M19,3H14.82C14.4,1.84,13.3,1,12,1S9.6,1.84,9.18,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M12,3c0.55,0,1,0.45,1,1s-0.45,1-1,1s-1-0.45-1-1S11.45,3,12,3z M10,17l-4-4l1.41-1.41L10,14.17l6.59-6.59L18,9L10,17z" fill="#b8c2d1" />
                                        <Label text="Tâches" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#navRevenue" styleClass="menu-item, active-menu-item">
                                    <children>
                                        <SVGPath content="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12.5,17h-1v-1.1c-1.39-0.23-2.28-1.35-2.28-2.54h1.5 c0,0.86,0.59,1.52,1.69,1.52c1.14,0,1.59-0.65,1.59-1.22c0-0.78-0.69-1.1-1.78-1.42c-1.63-0.47-2.61-1.24-2.61-2.48 c0-1.1,0.87-2.05,2.08-2.33V6h1v1.17c1.13,0.22,1.96,1.14,2.04,2.18h-1.5c-0.09-0.56-0.56-1.12-1.48-1.12 c-0.91,0-1.41,0.55-1.41,1.11c0,0.73,0.61,1.01,1.87,1.38c1.65,0.48,2.52,1.26,2.52,2.52C14.75,15.82,13.88,16.73,12.5,17z" fill="WHITE" />
                                        <Label text="Revenus" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#navAskMe" styleClass="menu-item">
                                    <children>
                                        <SVGPath content="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M13,14h-2v-2h2V14z M13,10h-2V6h2V10z" fill="#b8c2d1" />
                                        <Label text="Demandez-moi" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#navProfile" styleClass="menu-item">
                                    <children>
                                        <SVGPath content="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,5c1.66,0,3,1.34,3,3s-1.34,3-3,3 s-3-1.34-3-3S10.34,5,12,5z M12,19.2c-2.5,0-4.71-1.28-6-3.22c0.03-1.99,4-3.08,6-3.08s5.97,1.09,6,3.08 C16.71,17.92,14.5,19.2,12,19.2z" fill="#b8c2d1" />
                                        <Label text="Mon Profil" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        
                        <HBox alignment="CENTER_LEFT" onMouseClicked="#navLogout" styleClass="menu-item, logout-item">
                            <children>
                                <SVGPath content="M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5L17,7z M4,5h8V3H4C2.9,3,2,3.9,2,5v14c0,1.1,0.9,2,2,2h8v-2H4V5z" fill="#b8c2d1" />
                                <Label text="Déconnexion" />
                            </children>
                            <VBox.margin>
                                <Insets bottom="30.0" left="20.0" right="20.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
            </left>
            
            <!-- Center Main Content -->
            <center>
                <VBox styleClass="main-content">
                    <children>
                        <!-- Top Nav -->
                        <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" styleClass="top-nav">
                            <children>
                                <Label text="Analyse des revenus" styleClass="section-title-large">
                                    <font>
                                        <Font size="28.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                
                                <!-- Filter Controls -->
                                <VBox spacing="10.0">
                                    <children>
                                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                                            <children>
                                                <ComboBox fx:id="periodComboBox" prefWidth="150.0" />
                                                <DatePicker fx:id="startDatePicker" prefWidth="120.0" />
                                                <Label text="au" />
                                                <DatePicker fx:id="endDatePicker" prefWidth="120.0" />
                                                <Button fx:id="filterButton" styleClass="btn-primary" text="Appliquer" />
                                                <Button fx:id="resetButton" styleClass="btn-secondary" text="Réinitialiser" />
                                                <Button fx:id="exportButton" styleClass="btn-success" text="Exporter" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                            <padding>
                                <Insets left="30.0" right="30.0" />
                            </padding>
                        </HBox>
                        
                        <ScrollPane fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox spacing="30.0" styleClass="content-area">
                                    <padding>
                                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                                    </padding>
                                    <children>
                                        
                                        <!-- Revenue Summary Cards -->
                                        <HBox spacing="20.0">
                                            <children>
                                                <!-- Today Revenue -->
                                                <VBox fx:id="todayRevenueCard" styleClass="card dash-card" spacing="15.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Revenus d'aujourd'hui" styleClass="card-subtitle" />
                                                        <Label fx:id="todayRevenueBigLabel" text="$0.00" styleClass="card-value" />
                                                        <Label fx:id="todayRevenueChangeLabel" text="→ 0.0%" />
                                                    </children>
                                                </VBox>
                                                
                                                <!-- Weekly Revenue -->
                                                <VBox fx:id="weeklyRevenueCard" styleClass="card dash-card" spacing="15.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Revenus hebdomadaires" styleClass="card-subtitle" />
                                                        <Label fx:id="weeklyRevenueBigLabel" text="$0.00" styleClass="card-value" />
                                                        <Label fx:id="weeklyRevenueChangeLabel" text="→ 0.0%" />
                                                    </children>
                                                </VBox>
                                                
                                                <!-- Monthly Revenue -->
                                                <VBox fx:id="monthlyRevenueCard" styleClass="card dash-card" spacing="15.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Revenus mensuels" styleClass="card-subtitle" />
                                                        <Label fx:id="monthlyRevenueBigLabel" text="$0.00" styleClass="card-value" />
                                                        <Label fx:id="monthlyRevenueChangeLabel" text="→ 0.0%" />
                                                    </children>
                                                </VBox>
                                                
                                                <!-- Yearly Revenue -->
                                                <VBox fx:id="yearlyRevenueCard" styleClass="card dash-card" spacing="15.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Revenus annuels" styleClass="card-subtitle" />
                                                        <Label fx:id="yearlyRevenueBigLabel" text="$0.00" styleClass="card-value" />
                                                        <Label fx:id="yearlyRevenueChangeLabel" text="→ 0.0%" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <!-- Statistics Panel -->
                                        <HBox spacing="20.0">
                                            <children>
                                                <VBox styleClass="card" spacing="15.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Revenus totaux" styleClass="card-subtitle" />
                                                        <Label fx:id="totalRevenueLabel" text="$0.00" styleClass="card-value" />
                                                    </children>
                                                </VBox>
                                                <VBox styleClass="card" spacing="15.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Revenu quotidien moyen" styleClass="card-subtitle" />
                                                        <Label fx:id="avgDailyRevenueLabel" text="$0.00" styleClass="card-value" />
                                                    </children>
                                                </VBox>
                                                <VBox styleClass="card" spacing="15.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Meilleur jour" styleClass="card-subtitle" />
                                                        <Label fx:id="bestDayLabel" text="Lundi" styleClass="card-value" />
                                                    </children>
                                                </VBox>
                                                <VBox styleClass="card" spacing="15.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Total des rendez-vous" styleClass="card-subtitle" />
                                                        <Label fx:id="totalAppointmentsLabel" text="0" styleClass="card-value" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <!-- Charts Row -->
                                        <HBox spacing="30.0">
                                            <children>
                                                <!-- Revenue Trend Chart -->
                                                <VBox styleClass="card" spacing="20.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Tendance des revenus (14 derniers jours)" styleClass="section-title-large" />
                                                        <LineChart fx:id="revenueTrendChart" prefHeight="300.0" legendVisible="false">
                                                            <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                                                            <yAxis><NumberAxis side="LEFT" /></yAxis>
                                                        </LineChart>
                                                    </children>
                                                </VBox>
                                                
                                                <!-- Payment Status Chart -->
                                                <VBox styleClass="card" spacing="20.0" prefWidth="350.0">
                                                    <children>
                                                        <Label text="Statut de paiement" styleClass="section-title-large" />
                                                        <PieChart fx:id="paymentStatusChart" prefHeight="300.0" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <!-- Monthly Revenue Chart -->
                                        <VBox styleClass="card" spacing="20.0">
                                            <children>
                                                <Label text="Revenus mensuels cette année" styleClass="section-title-large" />
                                                <BarChart fx:id="monthlyRevenueChart" prefHeight="350.0" legendVisible="false">
                                                    <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                                                    <yAxis><NumberAxis side="LEFT" /></yAxis>
                                                </BarChart>
                                            </children>
                                        </VBox>

                                        <!-- Treatment Revenue Chart -->
                                        <VBox styleClass="card" spacing="20.0">
                                            <children>
                                                <Label text="Revenus par type de traitement" styleClass="section-title-large" />
                                                <BarChart fx:id="treatmentRevenueChart" prefHeight="300.0" legendVisible="false">
                                                    <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                                                    <yAxis><NumberAxis side="LEFT" /></yAxis>
                                                </BarChart>
                                            </children>
                                        </VBox>

                                        <!-- Daily Revenue Table -->
                                        <VBox styleClass="card" spacing="20.0">
                                            <children>
                                                <Label text="Détail des revenus quotidiens (30 derniers jours)" styleClass="section-title-large" />
                                                <TableView fx:id="dailyRevenueTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="dailyDateCol" text="Date" prefWidth="120" />
                                                        <TableColumn fx:id="dailyRevenueCol" text="Revenus" prefWidth="150" />
                                                        <TableColumn fx:id="dailyAppointmentsCol" text="Rendez-vous" prefWidth="120" />
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>

                                        <!-- Monthly Revenue Table -->
                                        <VBox styleClass="card" spacing="20.0">
                                            <children>
                                                <Label text="Détail des revenus mensuels" styleClass="section-title-large" />
                                                <TableView fx:id="monthlyRevenueTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="monthlyMonthCol" text="Mois" prefWidth="120" />
                                                        <TableColumn fx:id="monthlyRevenueCol" text="Revenus" prefWidth="150" />
                                                        <TableColumn fx:id="monthlyAppointmentsCol" text="Rendez-vous" prefWidth="120" />
                                                        <TableColumn fx:id="monthlyAvgCol" text="Revenu moyen" prefWidth="150" />
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                        
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </center>
        </BorderPane>

        <!-- Window Controls -->
        <HBox alignment="TOP_RIGHT" spacing="8.0" styleClass="win-control-box" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleMinimize" styleClass="win-btn, win-btn-min" text="—" />
                <Button mnemonicParsing="false" onAction="#handleMaximize" styleClass="win-btn, win-btn-max" text="□" />
                <Button mnemonicParsing="false" onAction="#handleClose" styleClass="win-btn, win-btn-close" text="✕" />
            </children>
        </HBox>
    </children>
</AnchorPane>
